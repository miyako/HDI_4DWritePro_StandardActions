{
	"destination": "detailScreen",
	"windowSizingX": "fixed",
	"windowSizingY": "fixed",
	"width": 860,
	"height": 520,
	"menuBar": "Menu Bar #1",
	"markerHeader": 15,
	"markerBody": 200,
	"markerBreak": 220,
	"markerFooter": 240,
	"events": [
		"onLoad",
		"onValidate",
		"onClick",
		"onDoubleClick",
		"onMenuSelect",
		"onDataChange",
		"onUnload",
		"onAfterEdit",
		"onPageChange"
	],
	"method": "method.4dm",
	"pageFormat": {
		"paperName": "US Letter",
		"paperWidth": "612pt",
		"paperHeight": "792pt"
	},
	"pages": [
		{
			"objects": {
				"Variable7": {
					"type": "input",
					"top": 70,
					"left": 40,
					"width": 760,
					"height": 401,
					"sizingX": "grow",
					"dataSource": "Var",
					"focusable": false,
					"fill": "transparent",
					"borderStyle": "none",
					"enterable": false,
					"styledText": true,
					"contextMenu": "none",
					"dragging": "none",
					"dropping": "custom",
					"events": [
						"onDataChange"
					]
				},
				"Tab Control": {
					"type": "tab",
					"top": 20,
					"left": 20,
					"width": 820,
					"height": 480,
					"sizingX": "grow",
					"sizingY": "grow",
					"dataSource": "TabControl",
					"dataSourceTypeHint": "arrayText",
					"labels": [
						"Page 1",
						"Page 2",
						"Page 3"
					],
					"action": "GotoPage",
					"events": [
						"onClick"
					]
				},
				"WParea": {
					"type": "write",
					"top": 173,
					"left": 40,
					"width": 311,
					"height": 309,
					"visibility": "hidden",
					"sizingX": "grow",
					"sizingY": "grow",
					"dataSource": "WParea",
					"hideFocusRing": true,
					"contextMenu": "none",
					"scrollbarVertical": "automatic",
					"scrollbarHorizontal": "automatic",
					"showSelection": true,
					"showHorizontalRuler": false,
					"showVerticalRuler": false,
					"layoutMode": "embedded",
					"method": "ObjectMethods/WParea.4dm",
					"events": [
						"onLoad",
						"onClick",
						"onLosingFocus",
						"onGettingFocus",
						"onSelectionChange",
						"onAfterEdit"
					]
				}
			}
		},
