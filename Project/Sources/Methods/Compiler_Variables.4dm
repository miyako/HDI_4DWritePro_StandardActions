//%attributes = {"invisible":true}
  // Process variables shared across HDI2/method.4dm, HDI2's ObjectMethods, and initHDI.4dm.
  // menu/menuContext hold menu reference numbers created with Create menu.
  // Var/Var1..Var7 hold per-tab text content bound to Variable7's dataSource ("Var").
var menu; menuContext : Integer
var Var; Var1; Var2; Var3; Var4; Var5; Var6; Var7 : Text
